# Copie para .env (o .env não vai para o git) e preencha a chave para a camada de SI.
# Sem chave, a interface usa só o texto determinístico por regras.
OPENAI_API_KEY=
# Padrão: gpt-6-luna (mesmo modelo do motor Python; US$ 0,10 entrada / 0,50 saída por 1M tokens, conferido em 2026-11-15)
OPENAI_MODEL=
# "none" evita tokens de raciocínio ocultos. Deixe vazio para não enviar o parâmetro.
LLM_REASONING_EFFORT=none
# Servidor compatível com a OpenAI (opcional, por exemplo um modelo local)
OPENAI_BASE_URL=
# Tetos de gasto (ao atingir, volta ao texto por regras). 0 ou off = sem teto.
LLM_USD_PER_DAY=off
LLM_CALLS_PER_DAY=off
# Teto acumulado de todos os dias (soma do registro web/.cache/llm_ledger.jsonl)
LLM_USD_TOTAL=4.50

# Chave grátis da NASA para baixar todos os eventos solares (scripts/fetch_space_weather.py)
NASA_API_KEY=
